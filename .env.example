# SMTP credentials for the contact form (src/app/api/contact/route.ts).
# Copy this file to .env.local and fill in real values — .env.local is
# git-ignored and never committed.
#
# Without these set, the contact form still works end-to-end (validation,
# submission, success state) but enquiries are only logged server-side,
# not emailed.

# Example for Google Workspace (smtp.gmail.com):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=info@charelizng.com
#   SMTP_PASSWORD=<16-character Google "App Password", not your normal password>
#
# Example for Zoho Mail:
#   SMTP_HOST=smtp.zoho.com
#   SMTP_PORT=465
#   SMTP_USER=info@charelizng.com
#   SMTP_PASSWORD=<Zoho app-specific password>

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Optional — defaults to SMTP_USER for both if left blank.
CONTACT_TO_EMAIL=info@charelizng.com
CONTACT_FROM_EMAIL=
